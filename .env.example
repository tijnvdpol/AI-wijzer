# Kopieer dit bestand naar .env en vul je eigen sleutels in.
OPENAI_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=
# OpenAI-model met web search en gestructureerde uitvoer; pas aan zonder codewijzigingen (bijv. gpt-5 of gpt-4.1)
OPENAI_MODEL=gpt-5-mini
PORT=3001
# Maximaal aantal adviezen per IP-adres per dag (standaard 5)
DAILY_LIMIT=5
# Pincode voor de app (verplicht op Vercel; lokaal leeg = geen pincode)
ACCESS_PIN=
